+++ b/src/api/local_config/editor.rs
@@ -0,0 +1,270 @@
+//! Source-preserving typed edits. Literal keys are separate path components;
+//! array indices are integers, so dots and numeric keys remain unambiguous.
+use serde::{Deserialize, Serialize};
+use sha2::{Digest, Sha256};
+use toml_edit::{DocumentMut, Item, Value};
+
+#[derive(Deserialize)]
+#[serde(untagged)]
+pub(super) enum Segment {
+    Key(String),
+    Index(usize),
+}
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+pub(super) struct Edit {
+    pub path: Vec<Segment>,
+    pub literal: Option<String>,
+}
+#[derive(Serialize)]
+pub(super) struct Node {
+    kind: &'static str,
+    value: String,
+    children: Vec<Child>,
+}
+#[derive(Serialize)]
+struct Child {
+    key: String,
+    node: Node,
+}
+
+// Include syntax is line-oriented and may repeat keys or occur inside a table.
+// Keep the directives unchanged: changing topology can acquire an unregistered
+// file and cannot be validated as a single-owner transaction.
+pub(super) fn include_directives(source: &str) -> Vec<&str> {
+    source
+        .lines()
+        .filter(|line| {
+            line.trim()
+                .strip_prefix("include")
+                .is_some_and(|tail| tail.trim().starts_with('='))
+        })
+        .collect()
+}
+
+fn masked(source: &str) -> (String, Vec<(String, String)>) {
+    let prefix = hex::encode(Sha256::digest(source.as_bytes()));
+    let mut includes = Vec::new();
+    let mut output = String::new();
+    for line in source.split_inclusive('\n') {
+        if !include_directives(line).is_empty() {
+            let marker = format!("# __telemt_include_{prefix}_{}__", includes.len());
+            includes.push((marker.clone(), line.to_owned()));
+            output.push_str(&marker);
+            output.push('\n');
+        } else {
+            output.push_str(line);
+        }
+    }
+    (output, includes)
+}
+fn unmask(source: &str, includes: &[(String, String)]) -> String {
+    let mut output = String::new();
+    for line in source.split_inclusive('\n') {
+        if let Some((_, original)) = includes.iter().find(|(marker, _)| line.trim() == marker) {
+            output.push_str(original)
+        } else {
+            output.push_str(line)
+        }
+    }
+    output
+}
+fn visit(item: &Item, budget: &mut usize, depth: usize) -> Result<Node, ()> {
+    if *budget == 0 || depth > 32 {
+        return Err(());
+    };
+    *budget -= 1;
+    let mut node = Node {
+        kind: "table",
+        value: String::new(),
+        children: Vec::new(),
+    };
+    if let Some(table) = item.as_table_like() {
+        for (key, value) in table.iter() {
+            node.children.push(Child {
+                key: key.to_owned(),
+                node: visit(value, budget, depth + 1)?,
+            });
+        }
+    } else if item.is_array() || item.is_array_of_tables() {
+        node.kind = "array";
+        let len = item
+            .as_array()
+            .map(|a| a.len())
+            .or_else(|| item.as_array_of_tables().map(|a| a.len()))
+            .ok_or(())?;
+        for i in 0..len {
+            node.children.push(Child {
+                key: i.to_string(),
+                node: visit(item.get(i).ok_or(())?, budget, depth + 1)?,
+            });
+        }
+    } else if let Some(value) = item.as_value() {
+        node.kind = match value {
+            Value::String(_) => "string",
+            Value::Integer(_) => "integer",
+            Value::Float(_) => "float",
+            Value::Boolean(_) => "boolean",
+            Value::Datetime(_) => "datetime",
+            _ => return Err(()),
+        };
+        if let Some(value) = value.as_str() {
+            node.value = value.to_owned();
+        } else {
+            let mut value = value.clone();
+            value.decor_mut().clear();
+            node.value = value.to_string();
+        }
+    } else {
+        return Err(());
+    }
+    Ok(node)
+}
+pub(super) fn tree(source: &str) -> Result<Node, ()> {
+    let (masked, _) = masked(source);
+    let doc = masked.parse::<DocumentMut>().map_err(|_| ())?;
+    visit(doc.as_item(), &mut 4096, 0)
+}
+fn parent<'a>(item: &'a mut Item, path: &[Segment]) -> Result<&'a mut Item, ()> {
+    let Some((first, rest)) = path.split_first() else {
+        return Ok(item);
+    };
+    let child = match first {
+        Segment::Key(key) => item.get_mut(key.as_str()),
+        Segment::Index(index) => item.get_mut(*index),
+    }
+    .ok_or(())?;
+    parent(child, rest)
+}
+fn edit(doc: &mut DocumentMut, change: &Edit) -> Result<(), ()> {
+    if change.path.is_empty()
+        || change.path.len() > 32
+        || change
+            .path
+            .iter()
+            .any(|p| matches!(p,Segment::Key(k)if k.len()>256))
+    {
+        return Err(());
+    }
+    let (last, path) = change.path.split_last().ok_or(())?;
+    let item = parent(doc.as_item_mut(), path)?;
+    let value = change
+        .literal
+        .as_ref()
+        .map(|literal| {
+            if literal.len() > 1024 * 1024 {
+                return Err(());
+            };
+            literal.parse::<Value>().map_err(|_| ())
+        })
+        .transpose()?;
+    match last {
+        Segment::Key(key) => {
+            let table = item.as_table_like_mut().ok_or(())?;
+            if let Some(mut value) = value {
+                if let Some(old) = table.get(key).and_then(Item::as_value) {
+                    *value.decor_mut() = old.decor().clone();
+                }
+                table.insert(key, Item::Value(value));
+            } else {
+                table.remove(key);
+            }
+        }
+        Segment::Index(index) => {
+            if let Some(array) = item.as_array_mut() {
+                if *index > array.len() {
+                    return Err(());
+                }
+                if let Some(value) = value {
+                    if *index == array.len() {
+                        array.push(value)
+                    } else {
+                        array.replace(*index, value);
+                    }
+                } else if *index < array.len() {
+                    array.remove(*index);
+                } else {
+                    return Err(());
+                }
+            } else if let Some(array) = item.as_array_of_tables_mut() {
+                if *index > array.len() {
+                    return Err(());
+                }
+                if let Some(Value::InlineTable(value)) = value {
+                    let table = value.into_table();
+                    if *index == array.len() {
+                        array.push(table)
+                    } else {
+                        *array.get_mut(*index).ok_or(())? = table;
+                    }
+                } else if value.is_none() && *index < array.len() {
+                    array.remove(*index);
+                } else {
+                    return Err(());
+                }
+            } else {
+                return Err(());
+            }
+        }
+    }
+    Ok(())
+}
+pub(super) fn render(source: &str, changes: &[Edit]) -> Result<(String, Node), ()> {
+    if changes.len() > 256 {
+        return Err(());
+    }
+    let (masked, includes) = masked(source);
+    let mut doc = masked.parse::<DocumentMut>().map_err(|_| ())?;
+    for change in changes {
+        edit(&mut doc, change)?;
+    }
+    let content = unmask(&doc.to_string(), &includes);
+    if include_directives(source) != include_directives(&content) {
+        return Err(());
+    }
+    let tree = tree(&content)?;
+    Ok((content, tree))
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn preserves_comments_includes_literal_keys_and_large_integers() {
+        let source = "# retain\ninclude = \"a.toml\"\ninclude = \"b.toml\"\n[access.user_max_tcp_conns]\n\"a.b\" = 3 # keep\n[general]\nvalue = 9007199254740993\n";
+        let change = Edit {
+            path: vec![
+                Segment::Key("access".into()),
+                Segment::Key("user_max_tcp_conns".into()),
+                Segment::Key("a.b".into()),
+            ],
+            literal: Some("5".into()),
+        };
+        let (content, node) = render(source, &[change]).expect("render");
+        assert!(content.contains("\"a.b\" = 5 # keep"));
+        assert!(content.contains("# retain"));
+        assert_eq!(include_directives(source), include_directives(&content));
+        let encoded = serde_json::to_string(&node).expect("json");
+        assert!(encoded.contains("9007199254740993"));
+    }
+    #[test]
+    fn edits_arrays_and_tables_without_ambiguous_dot_paths() {
+        let source = "values=[1,2]\n[[upstreams]]\ntype='direct'\n";
+        let change = Edit {
+            path: vec![Segment::Key("values".into()), Segment::Index(2)],
+            literal: Some("3".into()),
+        };
+        let (content, _) = render(source, &[change]).expect("append");
+        let value: toml::Value = toml::from_str(&content).expect("toml");
+        assert_eq!(value["values"].as_array().expect("array").len(), 3);
+        let change = Edit {
+            path: vec![
+                Segment::Key("upstreams".into()),
+                Segment::Index(0),
+                Segment::Key("type".into()),
+            ],
+            literal: Some("\"socks5\"".into()),
+        };
+        let (content, _) = render(&content, &[change]).expect("nested");
+        assert!(content.contains("socks5"));
+    }
+}
