@@ -0,0 +1,259 @@
+//! Offline, bounded configuration protocol for an explicitly installed node agent.
+//! This surface is not routed by the network API. It shares the API writer's
+//! root lock and source fences rather than creating a second persistence path.
+
+use std::io::{Read, Write};
+use std::path::{Path, PathBuf};
+
+use serde::Deserialize;
+use serde_json::{Value, json};
+
+use super::config_store::{compute_source_revision, write_atomic_with_runtime_check};
+use crate::config::ProxyConfig;
+use crate::crypto::sha256;
+
+mod editor;
+
+const MAX_INPUT: u64 = 16 * 1024 * 1024;
+const MAX_GRAPH: usize = 16 * 1024 * 1024;
+const MAX_SOURCE: usize = 8 * 1024 * 1024;
+const MAX_SOURCES: usize = 64;
+
+#[derive(Deserialize)]
+#[serde(rename_all = "snake_case")]
+enum Action {
+    Inspect,
+    Render,
+    Validate,
+    Apply,
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Request {
+    #[serde(default)]
+    edits: Vec<editor::Edit>,
+    action: Action,
+    #[serde(default)]
+    revision: String,
+    #[serde(default)]
+    source_id: String,
+    #[serde(default)]
+    content: String,
+}
+
+struct Failure {
+    status: u16,
+    code: &'static str,
+}
+impl Failure {
+    fn new(status: u16, code: &'static str) -> Self {
+        Self { status, code }
+    }
+}
+
+fn source_id(path: &Path) -> String {
+    hex::encode(sha256(path.to_string_lossy().as_bytes()))
+}
+
+async fn execute(root: PathBuf, request: Request) -> Result<Value, Failure> {
+    let read_root = root.clone();
+    let graph = tokio::task::spawn_blocking(move || ProxyConfig::read_source_graph(read_root))
+        .await
+        .map_err(|_| Failure::new(500, "config_source_unavailable"))?
+        .map_err(|_| Failure::new(400, "config_source_unavailable"))?;
+    if graph.source_contents.len() > MAX_SOURCES
+        || graph
+            .source_contents
+            .values()
+            .map(String::len)
+            .sum::<usize>()
+            > MAX_GRAPH
+    {
+        return Err(Failure::new(413, "config_graph_limit"));
+    }
+    let revision = compute_source_revision(&graph);
+    if matches!(request.action, Action::Inspect) {
+        let sources: Vec<Value> = graph.source_contents.iter().map(|(path, content)| {
+            json!({"id": source_id(path), "name": path.to_string_lossy(), "content": content, "tree": editor::tree(content).ok()})
+        }).collect();
+        return Ok(json!({"protocol":1,"revision":revision,"sources":sources}));
+    }
+    if request.revision != revision {
+        return Err(Failure::new(409, "revision_conflict"));
+    }
+    if request.content.len() > MAX_SOURCE {
+        return Err(Failure::new(413, "config_source_limit"));
+    }
+    let (owner, old_content) = graph
+        .source_contents
+        .iter()
+        .find(|(path, _)| source_id(path) == request.source_id)
+        .ok_or_else(|| Failure::new(404, "config_source_not_found"))?;
+    if editor::include_directives(old_content) != editor::include_directives(&request.content) {
+        return Err(Failure::new(409, "config_include_topology_changed"));
+    }
+    if matches!(request.action, Action::Render) {
+        let (content, tree) = editor::render(&request.content, &request.edits)
+            .map_err(|_| Failure::new(400, "config_editor_invalid"))?;
+        return Ok(json!({"protocol":1,"revision":revision,"content":content,"tree":tree}));
+    }
+    if !request.edits.is_empty() {
+        return Err(Failure::new(400, "config_request_invalid"));
+    }
+    let owner = owner.clone();
+    let old_content = old_content.clone();
+    let mut overrides = graph.source_contents;
+    overrides.insert(owner.clone(), request.content.clone());
+    let parse_root = root.clone();
+    let parsed = tokio::task::spawn_blocking(move || {
+        ProxyConfig::parse_source_with_overrides(parse_root, &overrides)
+    })
+    .await
+    .map_err(|_| Failure::new(500, "config_validation_unavailable"))?
+    .map_err(|_| Failure::new(400, "config_validation_failed"))?;
+    // Prepare DNS and immutable WEB resources exactly as the API candidate
+    // loader does. Validation success still does not establish listener readiness.
+    let prepared = parsed
+        .prepare()
+        .await
+        .map_err(|_| Failure::new(400, "config_preparation_failed"))?;
+    if matches!(request.action, Action::Validate) {
+        return Ok(
+            json!({"protocol":1,"revision":revision,"valid":true,"runtime_convergence":"unknown"}),
+        );
+    }
+    // Retain the prepared candidate until the source has been committed. All
+    // existing API writers use this same root advisory lock and graph fence.
+    let _prepared = prepared;
+    let committed =
+        write_atomic_with_runtime_check(root, revision, owner, old_content, request.content, None)
+            .await
+            .map_err(|error| Failure::new(error.status.as_u16(), error.code))?;
+    Ok(
+        json!({"protocol":1,"revision":committed,"persisted":true,"runtime_convergence":"unknown","restart_may_be_required":true}),
+    )
+}
+
+/// Reads one JSON request and emits one JSON response without running the proxy.
+/// Errors intentionally omit parser values, file contents and secret-bearing diagnostics.
+pub(crate) fn run(path: &str) -> i32 {
+    let result = (|| {
+        let mut input = Vec::new();
+        std::io::stdin()
+            .take(MAX_INPUT + 1)
+            .read_to_end(&mut input)
+            .map_err(|_| Failure::new(400, "config_request_invalid"))?;
+        if input.len() as u64 > MAX_INPUT {
+            return Err(Failure::new(413, "config_request_limit"));
+        }
+        let request: Request = serde_json::from_slice(&input)
+            .map_err(|_| Failure::new(400, "config_request_invalid"))?;
+        let runtime = tokio::runtime::Builder::new_current_thread()
+            .enable_all()
+            .build()
+            .map_err(|_| Failure::new(500, "config_validation_unavailable"))?;
+        runtime.block_on(execute(PathBuf::from(path), request))
+    })();
+    let (response, exit) = match result {
+        Ok(data) => (json!({"ok":true,"status":200,"data":data}), 0),
+        Err(failure) => (
+            json!({"ok":false,"status":failure.status,"error":{"code":failure.code}}),
+            1,
+        ),
+    };
+    let mut output = std::io::stdout().lock();
+    if serde_json::to_writer(&mut output, &response).is_err() || output.write_all(b"\n").is_err() {
+        return 1;
+    }
+    exit
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use tempfile::tempdir;
+
+    #[tokio::test]
+    async fn edits_one_owner_and_rejects_stale_revision_and_topology() {
+        let dir = tempdir().expect("tempdir");
+        let root = dir.path().join("config.toml");
+        let child = dir.path().join("access.toml");
+        std::fs::write(
+            &root,
+            "include = \"access.toml\"\n[general]\nlog_level = \"normal\"\n",
+        )
+        .expect("root");
+        std::fs::write(
+            &child,
+            "[access.users]\nalice = \"0123456789abcdef0123456789abcdef\"\n",
+        )
+        .expect("child");
+        let make = |action, revision: String, content: &str| Request {
+            edits: Vec::new(),
+            action,
+            revision,
+            source_id: source_id(&root),
+            content: content.to_owned(),
+        };
+        let inspected = execute(root.clone(), make(Action::Inspect, String::new(), ""))
+            .await
+            .ok()
+            .expect("inspect");
+        let revision = inspected["revision"].as_str().expect("revision").to_owned();
+        let original = std::fs::read_to_string(&root).expect("read");
+        let candidate = original.replace("normal", "debug");
+        assert!(
+            execute(
+                root.clone(),
+                make(Action::Validate, revision.clone(), &candidate)
+            )
+            .await
+            .is_ok()
+        );
+        assert_eq!(std::fs::read_to_string(&root).expect("read"), original);
+        assert!(
+            execute(
+                root.clone(),
+                make(Action::Apply, revision.clone(), &candidate)
+            )
+            .await
+            .is_ok()
+        );
+        let stale = execute(root.clone(), make(Action::Apply, revision, &original))
+            .await
+            .err()
+            .expect("stale");
+        assert_eq!(stale.code, "revision_conflict");
+        let inspected = execute(root.clone(), make(Action::Inspect, String::new(), ""))
+            .await
+            .ok()
+            .expect("inspect");
+        let revision = inspected["revision"].as_str().expect("revision").to_owned();
+        let topology = execute(
+            root.clone(),
+            make(
+                Action::Apply,
+                revision.clone(),
+                "include = \"other.toml\"\n",
+            ),
+        )
+        .await
+        .err()
+        .expect("topology");
+        assert_eq!(topology.code, "config_include_topology_changed");
+        let invalid = execute(
+            root.clone(),
+            make(
+                Action::Apply,
+                revision,
+                "include = \"access.toml\"\n[server]\nport = -1\n",
+            ),
+        )
+        .await
+        .err()
+        .expect("invalid");
+        assert_eq!(invalid.code, "config_validation_failed");
+        assert_eq!(std::fs::read_to_string(&root).expect("read"), candidate);
+    }
+}
