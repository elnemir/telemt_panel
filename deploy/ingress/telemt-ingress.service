[Unit]
Description=Telemt cluster ingress (HAProxy)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=haproxy
Group=haproxy
ExecStartPre=/usr/sbin/haproxy -c -f /etc/telemt-ingress/haproxy.cfg
ExecStart=/usr/sbin/haproxy -W -db -f /etc/telemt-ingress/haproxy.cfg
ExecReload=/usr/sbin/haproxy -c -f /etc/telemt-ingress/haproxy.cfg
ExecReload=/bin/kill -USR2 $MAINPID
Restart=on-failure
RestartSec=5
LimitNOFILE=65536
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077

[Install]
WantedBy=multi-user.target
