[Unit]
Description=Telemt cluster ingress (HAProxy)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=haproxy
Group=haproxy
ExecStartPre=/usr/sbin/haproxy -c -f /etc/telemt-ingress/haproxy.cfg
RuntimeDirectory=telemt-ingress
RuntimeDirectoryMode=0750
ExecStart=/usr/sbin/haproxy -W -db -S /run/telemt-ingress/master.sock,mode,600 -f /etc/telemt-ingress/haproxy.cfg
ExecReload=/usr/sbin/haproxy -c -f /etc/telemt-ingress/haproxy.cfg
ExecReload=/usr/local/libexec/telemt-ingress-reload
Restart=on-failure
RestartSec=5
LimitNOFILE=262144
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077

[Install]
WantedBy=multi-user.target
